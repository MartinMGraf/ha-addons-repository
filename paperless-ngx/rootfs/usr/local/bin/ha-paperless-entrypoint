#!/usr/bin/env bash
set -euo pipefail

options_file=/data/options.json
if [[ ! -f "${options_file}" ]]; then
    echo "Missing Home Assistant add-on options: ${options_file}" >&2
    exit 1
fi

read_option() {
    local key="$1"
    python3 - "${options_file}" "${key}" <<'PY'
import json
import sys

with open(sys.argv[1], encoding="utf-8") as options_file:
    options = json.load(options_file)

value = options.get(sys.argv[2], "")
print(value if value is not None else "")
PY
}

redis_host="$(read_option redis_host)"
redis_port="$(read_option redis_port)"
time_zone="$(read_option time_zone)"
paperless_url="$(read_option url)"

export PAPERLESS_REDIS="redis://${redis_host}:${redis_port}"
export PAPERLESS_DBENGINE=sqlite3
export PAPERLESS_TIME_ZONE="${time_zone}"
export PAPERLESS_DATA_DIR=/usr/src/paperless/data
export PAPERLESS_MEDIA_ROOT=/usr/src/paperless/media
export PAPERLESS_CONSUMPTION_DIR=/share/paperless-ngx/consume
export PAPERLESS_EXPORT_DIR=/share/paperless-ngx/export

if [[ -n "${paperless_url}" ]]; then
    export PAPERLESS_URL="${paperless_url}"
fi

mkdir -p /usr/src/paperless/data /usr/src/paperless/media \
    /share/paperless-ngx/consume /share/paperless-ngx/export

secret_file=/data/paperless-secret-key
if [[ ! -s "${secret_file}" ]]; then
    umask 077
    python3 - <<'PY' > "${secret_file}"
import secrets
print(secrets.token_urlsafe(64))
PY
fi
export PAPERLESS_SECRET_KEY="$(<"${secret_file}")"

exec /sbin/docker-init
